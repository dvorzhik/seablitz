[Unit]
Description=SeaBlitz web (FastAPI)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/seablitz
EnvironmentFile=/home/ubuntu/seablitz/.env
ExecStart=/home/ubuntu/seablitz/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8002 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
