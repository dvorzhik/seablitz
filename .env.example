# ---- Telegram ----
# Токен бота от @BotFather
BOT_TOKEN=123456789:PUT_YOUR_TOKEN_HERE
# Username бота без @ (например seablitz_bot)
BOT_USERNAME=seablitz_bot
# Short name «named» Mini App из BotFather (/newapp). Пусто — используется
# Mini App, привязанный к кнопке меню бота.
WEBAPP_SHORT_NAME=play
# Публичный адрес (для справки/логов)
BASE_URL=https://seablitz.example.com

# ---- Деплой (Caddy) ----
# Домен для автоматического HTTPS (Caddy). Обязателен для Mini App.
DOMAIN=seablitz.example.com
